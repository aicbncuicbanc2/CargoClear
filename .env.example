# Gemini API (Google AI Studio, free tier)
GEMINI_API_KEY=

# Dataset source: either a local path (after extracting the static ZIP)
# or the URL of the local Docker dataset server
DATASET_SOURCE=data
# DATASET_SOURCE=http://localhost:8080

# Optional: override the Gemini model id (Google retires ids periodically)
# GEMINI_MODEL=gemini-3.6-flash
